# BookTech Environment Variables
# Copy this file to .env and fill in your values

# ── Public (exposed to client) ────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_STRIPE_KEY=pk_test_...
NUXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NUXT_PUBLIC_MEILISEARCH_KEY=your_public_search_key
NUXT_PUBLIC_CLOUDFLARE_URL=https://your-bucket.r2.dev

# ── Private (server only) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
MEILISEARCH_ADMIN_KEY=your_admin_key
DATABASE_URL=postgresql://user:password@localhost:5432/booktech
AUTH_SECRET=your_super_secret_auth_key_min_32_chars
